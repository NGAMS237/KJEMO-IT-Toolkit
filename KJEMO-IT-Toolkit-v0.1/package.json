{
  "name": "kjemo-it-toolkit",
  "version": "0.1.0",
  "description": "KJEMO IT Toolkit — assistants et scripts PowerShell pour administration Windows",
  "type": "module",
  "scripts": {
    "generate": "node test/generate-ps1.mjs",
    "test:identity": "node test/identity.test.mjs",
    "test:browser": "node test/browser-identity.test.mjs",
    "test": "node test/identity.test.mjs && node test/sauvegarde-bloquante.test.mjs && node test/dns-change-bloquant.test.mjs && node test/route-passerelle-bloquante.test.mjs && node test/poste-verrous.test.mjs && node test/browser-identity.test.mjs",
    "test:sauvegarde": "node test/sauvegarde-bloquante.test.mjs",
    "test:dns-bloquant": "node test/dns-change-bloquant.test.mjs",
    "test:route-bloquant": "node test/route-passerelle-bloquante.test.mjs",
    "test:poste-verrous": "node test/poste-verrous.test.mjs",
    "test:roundtrip:emit": "node test/roundtrip.mjs emit test/generated/roundtrip",
    "test:roundtrip:verify": "node test/roundtrip.mjs verify test/generated/roundtrip",
    "test:bom": "node test/check-ps1-bom.mjs",
    "test:sources": "node test/sources-microsoft.mjs --json LOT-4-SOURCES.json",
    "test:sources:horsligne": "node test/sources-microsoft.mjs --hors-ligne",
    "test:cmdlets:export": "node test/cmdlets-export.mjs",
    "test:cmdlets": "node test/cmdlets-export.mjs && pwsh -File ./scripts/Test-KjemoCmdlets.ps1"
  },
  "devDependencies": {
    "@playwright/test": "1.44.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
